# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# Postgres (Neon free tier — https://neon.tech)
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Bearer secret sent by the external cron job to POST /api/cron/run-checks.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# LOG_LEVEL="info"
# Set to 1 only for CI builds that run without real secrets.
# SKIP_ENV_VALIDATION="1"
